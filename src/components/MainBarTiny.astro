---
import { Image } from 'astro:assets';
import BlogLogo from '../assets/blog_white2.png';
import '../styles/headerTiny.css';
---

<div class="container">
	<div class="title">
		<a href="/"><Image src={BlogLogo} alt="BlobbyBlog logo" style="height: 120%; width: auto"/></a>
	</div>
	<div class="header">
		<time class="date"></time>
		<div class="subheader">
			  <div class="header-item">
				  <a href="/about" target="">About</a>
			  </div>
			  <div class="header-item">
				  <a href="/blog" target="">Blog</a>
			  </div>
			  <div class="header-item">
				  <a href="https://github.com/RealFictionStudio" target="">Github</a>
			  </div>
		</div>
	</div>
</div>
<script src="../scripts/get-date.js"></script>
<hr style="width:40%;min-width:400px;height:2px;border-width:0;color:gray;background-color:gray;margin-top:2%">
<div class="categories">
	<div class="cat">
		<a href="/blog">Blog</a>
	</div>
	<div class="cat">
		<a href="/writeups">Writeups</a>
	</div>
	<div class="cat">
		<a href="">Mentions</a>
	</div>
			
</div>
