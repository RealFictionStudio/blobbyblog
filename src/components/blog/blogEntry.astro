---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import '../../styles/blog/blogEntry.css'

interface Props {
	ptitle: string;
	desc: string;
	path: string;
	imagePath: string;
	tags: string;
	ptype: number;

}

const { ptitle, desc, path, imagePath, tags, ptype } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpeg,jpg,png,gif,svg}');
if (!images[imagePath]) throw new Error(`"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,svg}"`);
---


<a href=`${path}` class="card">
	<div class=`item-${ptype}`>
		<div class="content">
			  <h1>{ptitle}</h1>
			  <p>{desc}</p>
			  <p>{tags}</p>
		</div>
		<div class="thumb">
			<div class="thumb-image">
				<Image src={images[imagePath]()} alt=`${ptitle} image` style={{ width: '100%', height: '100%' }} />
			</div>
		</div>
	</div>
</a>
