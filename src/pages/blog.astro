---
import { Image } from 'astro:assets';
import MainBarTiny from '../components/MainBarTiny.astro'
import '../styles/global.css';
import '../styles/blogPage.css'
import BlogEntry from '../components/blog/blogEntry.astro';
import BlogLogo from '../assets/blog_white.png';

const posts = Object.entries(
  import.meta.glob('../posts/*.md', { eager: true })
)
  .map(([path, post]) => ({
    slug: path.split('/').pop().replace(/\.md$/, ''),
    ...post,
  }))
  .sort(
    (a, b) =>
      Date.parse(b.frontmatter.date) - Date.parse(a.frontmatter.date)
  );
---

<html>
	<head>
		<title>Blobby Posts</title>
	</head>
	<body>
		<MainBarTiny />
		<div class="categories">
			<div class="cat">
				<a href="">Blog</a>
			</div>
			<div class="cat">
				<a href="">Writeups</a>
			</div>
			<div class="cat">
				<a href="">Mentions</a>
			</div>
			
		</div>

			<div class="posts">
				{posts.map((post) => (
				<BlogEntry 
				ptitle={`${post.frontmatter.title}`}
				desc={`${post.frontmatter.description}`}
				path={`/blog/posts/${post.slug}/`}
				imagePath={`/src/assets/${post.frontmatter.image}`}
				tags={`${post.frontmatter.tags}`}
				ptype=1 />
				))}
			</div>
	</body>
</html>
